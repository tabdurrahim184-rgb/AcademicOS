# docker compose için. Bu dosyayı .env.docker olarak kopyalayın; .env.docker git'e eklenmez.
# Veritabanı parolaları (docker compose bunları kabuk ortamından da okur: export ile verin)
# POSTGRES_PASSWORD=...  APP_DB_PASSWORD=...  OWNER_DB_PASSWORD=...

# DEBİM anahtarlarını şifrelemek için (32 bayt base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

ALLOW_REGISTRATION=true
TRUST_PROXY=false

# Yapay zekâ (isteğe bağlı, ÜCRETLİ). Boşsa kapalı.
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DAILY_REQUEST_LIMIT=50
# AI_MONTHLY_BUDGET_USD=5
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=

# Deşifre (isteğe bağlı, ÜCRETLİ): TRANSCRIPTION_PROVIDER=openai, TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_MODEL=
# TRANSCRIPTION_PRICE_PER_MIN=
