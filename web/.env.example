# Uygulama veritabanı bağlantısı (RLS'ye tabi, süper kullanıcı OLMAYAN rol)
DATABASE_URL=postgres://academicos_app:devapp@localhost:5432/academicos
# Migration için tablo sahibi rol
DATABASE_URL_OWNER=postgres://academicos_owner:devowner@localhost:5432/academicos

# Yapay zekâ (isteğe bağlı, ÜCRETLİ API). Boş bırakılırsa yapay zekâ özellikleri kapalıdır.
# AI_PROVIDER=anthropic | openai
AI_PROVIDER=
# AI_MODEL zorunludur: varsayılan model yoktur (maliyeti bilerek seçin)
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Yeni hesap açmayı kapatmak için: false
ALLOW_REGISTRATION=true
TRUST_PROXY=false

# Yapay zekâ maliyet kontrolü
# Desteklenen Anthropic modelleri: claude-haiku-5-5 (en ucuz), claude-sonnet-5-5, claude-opus-5-5 (en pahalı)
AI_DAILY_REQUEST_LIMIT=50
# AI_MONTHLY_BUDGET_USD=5
# OpenAI veya özel fiyat için (1M token başına USD):
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=
